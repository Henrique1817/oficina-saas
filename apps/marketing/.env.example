# URL pública do produto SaaS (apps/web). CTAs de signup/login apontam pra cá.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL pública deste site marketing (SEO, OG, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# WhatsApp de vendas (só dígitos, com DDI). Ex: 5511999999999
NEXT_PUBLIC_WHATSAPP=

# Postgres Supabase — obrigatório para gravar leads de /contato
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR_DB_PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR_DB_PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
