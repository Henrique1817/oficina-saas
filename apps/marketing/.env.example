# URL pública do produto SaaS (apps/web). CTAs de signup/login apontam pra cá.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL pública deste site marketing (SEO, OG, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Soft launch: true (padrão) = CTAs login/signup viram "Em Breve" e não clicam.
# false = libera acesso à plataforma.
NEXT_PUBLIC_PLATFORM_COMING_SOON=true

# WhatsApp de vendas (só dígitos, com DDI). Ex: 5511999999999
NEXT_PUBLIC_WHATSAPP=
