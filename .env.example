# ─── Supabase ───────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Prisma (Postgres via pooler IPv4 — recomendado) ────────────────────────
# Dashboard → Project Settings → Database → Connection string → Pooler
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR_DB_PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR_DB_PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── App ────────────────────────────────────────────────────────────────────
# Gere um valor aleatório forte (ex.: openssl rand -hex 32). Nunca commitar o real.
CRON_SECRET=generate_a_long_random_secret

# URL pública do app (sem barra final). Local: http://localhost:3000
# Em Docker: use a URL pública real e rode `docker compose up -d --build`
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Docker: aplicar migrations no boot do container (true/false)
RUN_MIGRATIONS=true

# E-mails com acesso ao console (apps/admin) e /admin/growth no web. Separados por vírgula.
PLATFORM_ADMIN_EMAILS=seu@email.com
# Opcional: só estes IPs acessam o console (vírgula). Vazio = qualquer IP.
# PLATFORM_ADMIN_IPS=127.0.0.1,::1

# URL do console (Docker :3001). Produto das oficinas usa NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Site marketing (Docker host :3004 → container :3002). CTAs apontam para NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3004
# Opcional: WhatsApp suporte/vendas (só dígitos com DDI). Ex: 5511999999999
# Usado no tenant (Faixa "Suporte") e na landing.
NEXT_PUBLIC_WHATSAPP=
# Opcional: e-mail de suporte (mailto no atalho do tenant)
NEXT_PUBLIC_SUPPORT_EMAIL=
# PORT do marketing no host (compose; padrão 3004)
# MARKETING_PORT=3004

# ─── E-mail (Resend — recomendado para convites personalizados) ─────────────
# Sem key: tenta SMTP nativo do Supabase Auth (inviteUserByEmail).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Oficina <onboarding@resend.dev>
# Supabase → Authentication → URL Configuration → Redirect URLs:
#   {NEXT_PUBLIC_APP_URL}/auth/callback
#   {NEXT_PUBLIC_APP_URL}/auth/callback/**

# ─── Mercado Pago (assinaturas — site_id MLB / BRL) ─────────────────────────
# Suas integrações → Credenciais de produção (APP_USR-…) ou teste (TEST-…)
# Nunca misturar token de produção com sandbox_init_point (e vice-versa).
MERCADOPAGO_ACCESS_TOKEN=APP_USR-or-TEST-your_access_token
# Webhooks → assinatura secreta (obrigatório em produção)
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret
# true = só sandbox_init_point; false = só init_point (produção).
# Se omitido: token TEST- implica sandbox (exceto se flag = false).
MERCADOPAGO_USE_SANDBOX=false
# Webhook URL no painel MP:
#   {NEXT_PUBLIC_APP_URL}/api/webhooks/mercadopago
# Planos (servidor): mensal R$ 97 / anual R$ 970 · trial 14 dias
# (BILLING_TRIAL_DAYS em apps/web/server/modules/billing)
# Importante: vendedor não pode pagar a própria assinatura com a mesma conta MP.
# App não pode ficar em sandbox_mode no painel se for cobrar de verdade.

# ─── Pipeline CI/CD (ingest de logs no admin /pipelines) ─────────────────────
# Mesmo valor pode ser o CRON_SECRET. Usado pelo GitHub Actions (Bearer).
PIPELINE_INGEST_SECRET=

