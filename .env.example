# ─── Supabase ───────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Prisma (Postgres via pooler IPv4 — recomendado) ────────────────────────
# Dashboard → Project Settings → Database → Connection string → Pooler
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR_DB_PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR_DB_PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── App ────────────────────────────────────────────────────────────────────
# Gere um valor aleatório forte (ex.: openssl rand -hex 32). Nunca commitar o real.
CRON_SECRET=generate_a_long_random_secret
# Bearer para GitHub Actions reportar steps da pipeline (admin → Pipelines).
# Pode ser igual ao CRON_SECRET; preferível secret dedicado.
PIPELINE_INGEST_SECRET=generate_another_long_random_secret

# URL pública do app (sem barra final). Local: http://localhost:3000
# Em Docker: use a URL pública real e rode `docker compose up -d --build`
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Docker: aplicar migrations no boot do container (true/false)
RUN_MIGRATIONS=true

# E-mails com acesso ao console (apps/admin) e /admin/growth no web. Separados por vírgula.
PLATFORM_ADMIN_EMAILS=henrimi4710@gmail.com
# Opcional: só estes IPs acessam o console (vírgula). Vazio = qualquer IP.
# PLATFORM_ADMIN_IPS=127.0.0.1,::1

# URL do console (Docker :3001). Produto das oficinas usa NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Site marketing (Docker host :3004 → container :3002). CTAs apontam para NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3004
# Opcional: WhatsApp suporte/vendas (só dígitos com DDI). Ex: 5511999999999
# Usado no tenant (Faixa "Suporte") e na landing.
NEXT_PUBLIC_WHATSAPP=
# Opcional: e-mail de suporte (mailto no atalho do tenant)
NEXT_PUBLIC_SUPPORT_EMAIL=
# PORT do marketing no host (compose; padrão 3004)
# MARKETING_PORT=3004

# ─── E-mail (Resend — opcional; sem key, só loga o link do convite) ──────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Oficina <onboarding@resend.dev>

# ─── Stripe (modo teste até o soft launch) ──────────────────────────────────
# Dashboard → Developers → API keys (prefira Restricted Key rk_test_… em vez de sk_test_)
STRIPE_SECRET_KEY=rk_test_or_sk_test_your_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Developers → Webhooks → endpoint /api/v1/billing/webhook → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Products → Price IDs do plano único (R$ 97/mês e R$ 970/ano)
STRIPE_PRICE_MONTHLY=price_1Tu0Z8QyNtoAJlmkDBwGZxIN
STRIPE_PRICE_YEARLY=price_1Tu0Z7QyNtoAJlmksl3PgHlb
# Trial: 14 dias grátis com cartão obrigatório no cadastro; cobrança automática depois
# (fixado em apps/web/server/modules/billing — BILLING_TRIAL_DAYS)
