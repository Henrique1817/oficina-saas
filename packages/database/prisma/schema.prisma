// Oficina Mecânica — schema multi-tenant (PostgreSQL / Supabase)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── RBAC ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  MECHANIC
}

enum PlanStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PlatformRole {
  OWNER
  SUPPORT
  FINANCE
  VIEWER
}

enum PipelineRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILURE
  CANCELLED
}

enum PipelineStepStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILURE
  SKIPPED
  CANCELLED
}

model Organization {
  id                   String     @id @default(cuid())
  name                 String
  slug                 String     @unique
  /// Contato comercial (PDF / WhatsApp)
  phone                String?
  email                String?
  address              String?    @db.Text
  /// Validade padrão do orçamento em dias
  quoteValidityDays    Int        @default(7) @map("quote_validity_days")
  /// Templates WhatsApp: [{ id, label, body }] com placeholders {{customer}}, {{total}}, etc.
  whatsappTemplates    Json       @default("[]") @map("whatsapp_templates")
  stripeCustomerId     String?    @unique @map("stripe_customer_id")
  stripeSubscriptionId String?    @unique @map("stripe_subscription_id")
  planStatus           PlanStatus @default(TRIALING) @map("plan_status")
  trialEndsAt          DateTime?  @map("trial_ends_at")
  /// Início do PAST_DUE — usado no dunning (acesso soft por alguns dias)
  pastDueAt            DateTime?  @map("past_due_at")
  /// Suspensão manual pelo console da plataforma (bloqueia acesso no web)
  suspendedAt          DateTime?  @map("suspended_at")
  /// Cortesia: sem cobrança/dunning; acesso liberado (exceto se suspensa)
  billingExempt        Boolean    @default(false) @map("billing_exempt")
  /// Soft launch / design partner (cohort 3–5 oficinas)
  designPartner        Boolean    @default(false) @map("design_partner")
  /// Contato do piloto (WhatsApp / e-mail) — só console da plataforma
  designPartnerContact String?    @map("design_partner_contact")
  /// Nota interna da equipe Oficina (não visível ao tenant)
  internalNote         String?    @map("internal_note") @db.Text
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  memberships          Membership[]
  invites              OrganizationInvite[]
  customers            Customer[]
  vehicles             Vehicle[]
  vehicleVariants      VehicleVariant[]
  parts                Part[]
  stockLocations       StockLocation[]
  inventoryMovements   InventoryMovement[]
  tools                Tool[]
  serviceOrders        ServiceOrder[]
  platformAuditLogs    PlatformAuditLog[]
  impersonationTokens  PlatformImpersonationToken[]

  @@index([designPartner])
  @@map("organizations")
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           UserRole @default(MECHANIC)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model OrganizationInvite {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  email          String
  role           UserRole @default(MECHANIC)
  token          String   @unique @default(cuid())
  invitedById    String?  @map("invited_by_id")
  acceptedAt     DateTime? @map("accepted_at")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    Profile?     @relation("InviteInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@index([token])
  @@map("organization_invites")
}

model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String   @map("full_name")
  /// Papel legado (single-tenant). Fonte de verdade no SaaS: Membership.role
  role      UserRole @default(MECHANIC)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships           Membership[]
  invitesSent           OrganizationInvite[] @relation("InviteInvitedBy")
  assignedServiceOrders ServiceOrder[]       @relation("AssignedMechanic")
  serviceOrderLabor     ServiceOrderLabor[]
  toolCheckouts         ToolCheckout[]
  inventoryMovements    InventoryMovement[]  @relation("MovementCreatedBy")
  statusHistoryChanges  ServiceOrderStatusHistory[]

  @@map("profiles")
}

// ─── Console da plataforma ───────────────────────────────────────────────────

model PlatformUser {
  id             String       @id @default(cuid())
  /// Preenchido no primeiro login; null = convite pendente
  userId         String?      @unique @map("user_id") @db.Uuid
  email          String       @unique
  role           PlatformRole @default(VIEWER)
  active         Boolean      @default(true)
  invitedByEmail String?      @map("invited_by_email")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([active, role])
  @@map("platform_users")
}

/// Última execução dos crons (Fase E — saúde / autonomia)
model PlatformCronRun {
  id        String   @id @default(cuid())
  job       String   @unique
  lastRunAt DateTime @map("last_run_at")
  lastOk    Boolean  @default(true) @map("last_ok")
  meta      Json?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_cron_runs")
}

/// Histórico de CI/CD (GitHub Actions → painel admin)
model PlatformPipelineRun {
  id            String            @id @default(cuid())
  provider      String            @default("GITHUB_ACTIONS")
  externalId    String            @map("external_id")
  workflow      String
  branch        String?
  commitSha     String?           @map("commit_sha")
  event         String?
  status        PipelineRunStatus @default(PENDING)
  url           String?
  deploymentUrl String?           @map("deployment_url")
  startedAt     DateTime          @default(now()) @map("started_at")
  finishedAt    DateTime?         @map("finished_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  steps PlatformPipelineStep[]

  @@unique([provider, externalId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("platform_pipeline_runs")
}

model PlatformPipelineStep {
  id         String             @id @default(cuid())
  runId      String             @map("run_id")
  name       String
  status     PipelineStepStatus @default(PENDING)
  order      Int                @default(0)
  logSummary String?            @map("log_summary") @db.Text
  startedAt  DateTime?          @map("started_at")
  finishedAt DateTime?          @map("finished_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  run PlatformPipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, name])
  @@index([runId, order])
  @@map("platform_pipeline_steps")
}

model PlatformAuditLog {
  id             String   @id @default(cuid())
  actorUserId    String   @map("actor_user_id") @db.Uuid
  actorEmail     String   @map("actor_email")
  action         String
  organizationId String?  @map("organization_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("platform_audit_logs")
}

model PlatformImpersonationToken {
  id             String    @id @default(cuid())
  token          String    @unique @default(cuid())
  organizationId String    @map("organization_id")
  actorUserId    String    @map("actor_user_id") @db.Uuid
  actorEmail     String    @map("actor_email")
  reason         String?
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([organizationId])
  @@map("platform_impersonation_tokens")
}

// ─── Clientes e veículos ────────────────────────────────────────────────────

model Customer {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  phone          String?
  email          String?
  document       String?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicles      Vehicle[]
  serviceOrders ServiceOrder[]

  @@index([organizationId, name])
  @@index([organizationId, phone])
  @@map("customers")
}

model VehicleVariant {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  make           String
  model          String
  yearStart      Int?    @map("year_start")
  yearEnd        Int?    @map("year_end")
  engine         String?
  transmission   String?
  notes          String?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicles     Vehicle[]
  fitments     PartVehicleFitment[]

  @@unique([organizationId, make, model, yearStart, yearEnd, engine])
  @@index([organizationId, make, model])
  @@map("vehicle_variants")
}

model Vehicle {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  customerId     String   @map("customer_id")
  variantId      String?  @map("variant_id")
  plate          String
  vehicleModel   String   @map("vehicle_model")
  vehicleYear    Int?     @map("vehicle_year")
  color          String?
  reportedIssue  String?  @map("reported_issue") @db.Text
  vin            String?
  mileage        Int?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  variant       VehicleVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  serviceOrders ServiceOrder[]

  @@unique([organizationId, plate])
  @@index([organizationId, customerId])
  @@map("vehicles")
}

// ─── Estoque e catálogo ───────────────────────────────────────────────────────

model StockLocation {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  name           String
  description    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockItems   StockItem[]

  @@unique([organizationId, name])
  @@map("stock_locations")
}

model Part {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  sku            String
  name           String
  description    String?
  unitCost       Decimal  @default(0) @map("unit_cost") @db.Decimal(12, 2)
  unitPrice      Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  minQuantity    Int      @default(0) @map("min_quantity")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fitments           PartVehicleFitment[]
  stockItems         StockItem[]
  inventoryMovements InventoryMovement[]
  serviceOrderLines  ServiceOrderLine[]

  @@unique([organizationId, sku])
  @@index([organizationId, name])
  @@map("parts")
}

model PartVehicleFitment {
  id        String @id @default(cuid())
  partId    String @map("part_id")
  variantId String @map("variant_id")
  notes     String?

  part    Part           @relation(fields: [partId], references: [id], onDelete: Cascade)
  variant VehicleVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([partId, variantId])
  @@index([variantId])
  @@map("part_vehicle_fitments")
}

model StockItem {
  id          String @id @default(cuid())
  partId      String @map("part_id")
  locationId  String @map("location_id")
  quantity    Int    @default(0)
  reservedQty Int    @default(0) @map("reserved_qty")

  part     Part          @relation(fields: [partId], references: [id], onDelete: Cascade)
  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([partId, locationId])
  @@index([partId])
  @@map("stock_items")
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
  OS_CONSUMPTION
  OS_RESERVATION
  OS_RELEASE
}

model InventoryMovement {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id")
  partId         String                @map("part_id")
  locationId     String?               @map("location_id")
  type           InventoryMovementType
  quantity       Int
  reference      String?
  serviceOrderId String?               @map("service_order_id")
  createdById    String?               @map("created_by_id")
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  part         Part          @relation(fields: [partId], references: [id], onDelete: Cascade)
  createdBy    Profile?      @relation("MovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  @@index([organizationId, partId, createdAt])
  @@index([serviceOrderId])
  @@map("inventory_movements")
}

// ─── Ferramentas ──────────────────────────────────────────────────────────────

enum ToolStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

model Tool {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  assetCode      String     @map("asset_code")
  name           String
  description    String?
  status         ToolStatus @default(AVAILABLE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkouts    ToolCheckout[]
  maintenances ToolMaintenance[]

  @@unique([organizationId, assetCode])
  @@map("tools")
}

model ToolCheckout {
  id             String    @id @default(cuid())
  toolId         String    @map("tool_id")
  checkedOutById String    @map("checked_out_by_id")
  serviceOrderId String?   @map("service_order_id")
  checkedOutAt   DateTime  @default(now()) @map("checked_out_at")
  returnedAt     DateTime? @map("returned_at")
  notes          String?

  tool         Tool          @relation(fields: [toolId], references: [id], onDelete: Cascade)
  checkedOutBy Profile       @relation(fields: [checkedOutById], references: [id], onDelete: Restrict)
  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  @@index([toolId, returnedAt])
  @@map("tool_checkouts")
}

enum ToolMaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ToolMaintenance {
  id          String                @id @default(cuid())
  toolId      String                @map("tool_id")
  status      ToolMaintenanceStatus @default(SCHEDULED)
  scheduledAt DateTime              @map("scheduled_at")
  completedAt DateTime?             @map("completed_at")
  description String
  cost        Decimal?              @db.Decimal(12, 2)
  createdAt   DateTime              @default(now()) @map("created_at")

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId, status])
  @@map("tool_maintenances")
}

// ─── Ordem de serviço ─────────────────────────────────────────────────────────

enum ServiceOrderStatus {
  DRAFT
  APPROVED
  IN_PROGRESS
  DONE
  INVOICED
  CANCELLED
}

model ServiceOrder {
  id                   String             @id @default(cuid())
  organizationId       String             @map("organization_id")
  orderNumber          Int                @map("order_number")
  customerId           String             @map("customer_id")
  vehicleId            String             @map("vehicle_id")
  assignedMechanicId   String?            @map("assigned_mechanic_id")
  status               ServiceOrderStatus @default(DRAFT)
  description          String?
  internalNotes        String?            @map("internal_notes")
  parentServiceOrderId String?            @map("parent_service_order_id")
  partsTotal           Decimal            @default(0) @map("parts_total") @db.Decimal(12, 2)
  laborTotal           Decimal            @default(0) @map("labor_total") @db.Decimal(12, 2)
  discount             Decimal            @default(0) @db.Decimal(12, 2)
  total                Decimal            @default(0) @db.Decimal(12, 2)
  openedAt             DateTime           @default(now()) @map("opened_at")
  approvedAt           DateTime?          @map("approved_at")
  quoteSentAt          DateTime?          @map("quote_sent_at")
  quoteApprovedAt      DateTime?          @map("quote_approved_at")
  quoteRejectedAt      DateTime?          @map("quote_rejected_at")
  quoteRejectionNotes  String?            @map("quote_rejection_notes") @db.Text
  completedAt          DateTime?          @map("completed_at")
  invoicedAt           DateTime?          @map("invoiced_at")
  /// Prazo prometido ao cliente
  dueAt                DateTime?          @map("due_at")
  /// Autorização de serviço pelo cliente (contrato simples)
  workAuthorizedAt     DateTime?          @map("work_authorized_at")
  workAuthorizedBy     String?            @map("work_authorized_by")
  workAuthorizedNotes  String?            @map("work_authorized_notes") @db.Text
  /// digital | print
  workAuthorizedMethod String?            @map("work_authorized_method")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle            Vehicle                      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  assignedMechanic   Profile?                     @relation("AssignedMechanic", fields: [assignedMechanicId], references: [id], onDelete: SetNull)
  parentServiceOrder ServiceOrder?                @relation("ServiceOrderReturn", fields: [parentServiceOrderId], references: [id], onDelete: SetNull)
  childServiceOrders ServiceOrder[]               @relation("ServiceOrderReturn")
  lines              ServiceOrderLine[]
  laborEntries       ServiceOrderLabor[]
  statusHistory      ServiceOrderStatusHistory[]
  inventoryMovements InventoryMovement[]
  toolCheckouts      ToolCheckout[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, dueAt])
  @@index([vehicleId])
  @@index([assignedMechanicId])
  @@map("service_orders")
}

enum ServiceOrderLineType {
  PART
  SERVICE
}

model ServiceOrderLine {
  id             String               @id @default(cuid())
  serviceOrderId String               @map("service_order_id")
  type           ServiceOrderLineType
  partId         String?              @map("part_id")
  description    String
  quantity       Decimal              @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal              @map("unit_price") @db.Decimal(12, 2)
  total          Decimal              @db.Decimal(12, 2)
  createdAt      DateTime             @default(now()) @map("created_at")

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  part         Part?        @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([serviceOrderId])
  @@map("service_order_lines")
}

model ServiceOrderLabor {
  id             String   @id @default(cuid())
  serviceOrderId String   @map("service_order_id")
  mechanicId     String   @map("mechanic_id")
  description    String
  minutes        Int
  hourlyRate     Decimal  @map("hourly_rate") @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  mechanic     Profile      @relation(fields: [mechanicId], references: [id], onDelete: Restrict)

  @@index([serviceOrderId])
  @@map("service_order_labor")
}

model ServiceOrderStatusHistory {
  id             String              @id @default(cuid())
  serviceOrderId String              @map("service_order_id")
  fromStatus     ServiceOrderStatus? @map("from_status")
  toStatus       ServiceOrderStatus  @map("to_status")
  changedById    String?             @map("changed_by_id")
  notes          String?
  createdAt      DateTime            @default(now()) @map("created_at")

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  changedBy    Profile?     @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([serviceOrderId, createdAt])
  @@map("service_order_status_history")
}
